{
  "name": "technical-drawing",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "preinstall": "node preinstall.cjs",
    "dev": "next dev --turbo",
